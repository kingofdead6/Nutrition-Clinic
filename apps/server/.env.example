# ---- Server ----
NODE_ENV=development
HOST=127.0.0.1
# 0 = random free port
PORT=4000

# ---- Database ----
# mongo | sqlite (sqlite: not implemented yet — desktop build)
DB_DRIVER=mongo
MONGO_URI=mongodb://127.0.0.1:27017/nutrition_clinic
# SQLITE_PATH=./data/clinic.db

# ---- Files (uploads, backups, local DB). Relative paths resolve from apps/server ----
DATA_DIR=./data
# UPLOADS_DIR=./data/uploads
# BACKUP_DIR=./data/backups

# Serve the built client from the API server (single origin). Leave empty in dev (Vite serves it).
# CLIENT_DIST_DIR=../client/dist

# ---- Security ----
# Comma-separated browser origins allowed to call the API with cookies
# Frontend address(es) allowed to use the API with the session cookie, e.g. https://my-clinic.vercel.app
# (https://nutrition-clinic-client.vercel.app and http://localhost:5173 are always allowed; "*" is ignored)
CORS_ORIGIN=
# REQUIRED in production, at least 32 random characters
# JWT_SECRET=
JWT_EXPIRES_IN_HOURS=168
# Failed login attempts allowed per IP per window
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MIN=15
# bcrypt cost factor (10-12 is a good range)
BCRYPT_ROUNDS=12
# true when served over HTTPS
# strict (frontend and API on the same site) | none (frontend elsewhere). Default: none on Render.
# COOKIE_SAMESITE=strict
COOKIE_SECURE=false
TRUST_PROXY=false

# ---- Logging ----
LOG_LEVEL=info
# LOG_PRETTY=true

# ---- Tests ----
# Point mongodb-memory-server at an installed mongod so tests never download anything, e.g.
# MONGOMS_SYSTEM_BINARY=C:\Program Files\MongoDB\Server\8.2\bin\mongod.exe
# MONGOMS_VERSION=8.2.2
